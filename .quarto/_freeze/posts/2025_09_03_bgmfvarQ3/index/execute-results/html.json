], type: 'scatter', mode: 'lines',\n\t\t\tline: {width: 0}, hoverinfo: 'skip', showlegend: false\n\t\t},\n\t\t{\n\t\t\tx: dates, y: values[4], type: 'scatter', mode: 'lines',\n\t\t\tline: {width: 0}, fill: 'tonexty', fillcolor: 'rgba(36, 112, 121, 0.13)',\n\t\t\tname: '95% interval', hovertemplate: '95% interval: %{y:.3f}<extra></extra>'\n\t\t},\n\t\t{\n\t\t\tx: dates, y: values[1], type: 'scatter', mode: 'lines',\n\t\t\tline: {width: 0}, hoverinfo: 'skip', showlegend: false\n\t\t},\n\t\t{\n\t\t\tx: dates, y: values[3], type: 'scatter', mode: 'lines',\n\t\t\tline: {width: 0}, fill: 'tonexty', fillcolor: 'rgba(36, 112, 121, 0.25)',\n\t\t\tname: '68% interval', hovertemplate: '68% interval: %{y:.3f}<extra></extra>'\n\t\t},\n\t\t{\n\t\t\tx: dates, y: values[2], type: 'scatter', mode: 'lines',\n\t\t\tline: {color: '#1e85e6', width: 2.5}, name: 'Median',\n\t\t\thovertemplate: 'Median: %{y:.3f}<extra></extra>'\n\t\t}\n\t];\n}\n\nfunction quarterlyAverage(dates, series) {\n\tconst quarterGroups = new Map();\n\n\tfor (let index = 0; index < dates.length; index += 1) {\n\t\tconst date = new Date(dates[index] + 'T00:00:00Z');\n\t\tconst quarter = Math.floor(date.getUTCMonth() / 3);\n\t\tconst key = date.getUTCFullYear() + '-' + quarter;\n\t\tif (!quarterGroups.has(key)) {\n\t\t\tquarterGroups.set(key, {year: date.getUTCFullYear(), quarter, indexes: []});\n\t\t}\n\t\tquarterGroups.get(key).indexes.push(index);\n\t}\n\n\tconst groups = [...quarterGroups.values()];\n\tconst quarterlyDates = groups.map(({year, quarter}) =>\n\t\tnew Date(Date.UTC(year, (quarter + 1) * 3, 0)).toISOString().slice(0, 10)\n\t);\n\tconst quarterlySeries = series.map(values => groups.map(({indexes}) =>\n\t\tindexes.reduce((sum, index) => sum + values[index], 0) / indexes.length\n\t));\n\n\treturn {dates: quarterlyDates, series: quarterlySeries};\n}\n\nconst quarterlyData = quarterlyAverage(forecastDates, forecastSeries);\nconst chartData = makeChartData(forecastDates, forecastSeries);\n\nconst chartLayout = {\n\tautosize: true,\n\theight: 560,\n\tmargin: {l: 64, r: 24, t: 24, b: 42},\n\tpaper_bgcolor: 'rgba(0,0,0,0)',\n\tplot_bgcolor: 'rgba(0,0,0,0)',\n\tfont: {family: 'Georgia, serif', color: '#283b3d', size: 13},\n\thovermode: 'x unified',\n\tlegend: {orientation: 'h', x: 0, y: 1.12},\n\txaxis: {\n\t\ttype: 'date',\n\t\trangeslider: {visible: true, thickness: 0.11, bgcolor: '#eef3f1'},\n\t\trangeselector: {\n\t\t\tbuttons: [\n\t\t\t\t{count: 1, label: '1y', step: 'year', stepmode: 'backward'},\n\t\t\t\t{count: 5, label: '5y', step: 'year', stepmode: 'backward'},\n\t\t\t\t{count: 10, label: '10y', step: 'year', stepmode: 'backward'},\n\t\t\t\t{step: 'all', label: 'All'}\n\t\t\t],\n\t\t\tx: 1, xanchor: 'right', y: 1.12, yanchor: 'bottom'\n\t\t},\n\t\tgridcolor: '#e5ebe8',\n\t\tlinecolor: '#aebbb7'\n\t},\n\tyaxis: {\n\t\ttitle: {text: 'GDP growth'},\n\t\tgridcolor: '#e5ebe8',\n\t\tzerolinecolor: '#aebbb7'\n\t}\n};\n\nPlotly.newPlot('gdp-forecast-chart', chartData, chartLayout, {\n\tresponsive: true,\n\tdisplaylogo: false,\n\tmodeBarButtonsToRemove: ['lasso2d', 'select2d']\n});\n\ndocument.querySelectorAll('[data-frequency]').forEach(button => {\n\tbutton.addEventListener('click', () => {\n\t\tconst quarterly = button.dataset.frequency === 'quarterly';\n\t\tconst dates = quarterly ? quarterlyData.dates : forecastDates;\n\t\tconst values = quarterly ? quarterlyData.series : forecastSeries;\n\n\t\tPlotly.react('gdp-forecast-chart', makeChartData(dates, values), chartLayout, {\n\t\t\tresponsive: true,\n\t\t\tdisplaylogo: false,\n\t\t\tmodeBarButtonsToRemove: ['lasso2d', 'select2d']\n\t\t});\n\n\t\tdocument.querySelectorAll('[data-frequency]').forEach(toggle => {\n\t\t\tconst selected = toggle === button;\n\t\t\ttoggle.classList.toggle('active', selected);\n\t\t\ttoggle.setAttribute('aria-pressed', String(selected));\n\t\t});\n\t});\n});\n</script>\n\n\n\n",
